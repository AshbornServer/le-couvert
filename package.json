{
  "name": "soupers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host --port 5000",
    "build": "vite build",
    "preview": "vite preview --host --port 5000",
    "start": "node build/index.js",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "lien": "node --experimental-strip-types scripts/lien.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.14",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "drizzle-kit": "^0.31.6",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^7.1.14"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "jsqr": "^1.4.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
}
