# --- Serveur ---
# NODE_ENV n'est pas mis ici : Vite le refuse en développement,
# et ecosystem.config.cjs le fournit en production.
ORIGINE_PUBLIQUE=http://localhost:5000
CHEMIN_BASE=./data/soupers.db

# --- Envoi des e-mails (transactionnel) ---
# FOURNISSEUR_MAIL : "console" (dev, affiche l'e-mail dans le terminal), "brevo" ou "resend"
FOURNISSEUR_MAIL=console
CLE_API_MAIL=
MAIL_EXPEDITEUR=ne-pas-repondre@exemple.be
MAIL_NOM_EXPEDITEUR=Réservations

# --- Super-admin ---
# Adresses autorisées à ouvrir /admin (séparées par des virgules)
EMAILS_SUPERADMIN=vous@exemple.be

# --- Mollie Connect ---
MOLLIE_CLIENT_ID=
MOLLIE_CLIENT_SECRET=
MOLLIE_REDIRECTION=http://localhost:5000/mollie/retour
